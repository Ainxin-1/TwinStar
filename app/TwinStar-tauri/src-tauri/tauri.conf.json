{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwinStar",
  "version": "0.12.0",
  "identifier": "com.ainxin.twinstar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TwinStar — 零成本互传",
        "width": 760,
